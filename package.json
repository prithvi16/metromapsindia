{
  "name": "metromapsindia",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive OpenStreetMap based web app for Indian cities",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "data:fetch": "node scripts/fetch-rail.mjs",
    "data:build": "node scripts/build-cities.mjs",
    "data:refresh": "node scripts/fetch-rail.mjs && node scripts/build-cities.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
